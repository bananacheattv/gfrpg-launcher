{
  "name": "aeloria-launcher",
  "productName": "Aeloria Launcher",
  "version": "1.3.3",
  "description": "Launcher officiel d'Aeloria (MMORPG Minecraft)",
  "author": "Copassist",
  "main": "src/main.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.copassist.gfrpg.launcher",
    "productName": "Aeloria Launcher",
    "artifactName": "Aeloria-Launcher-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "launcher-config.json",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bananacheattv",
        "repo": "gfrpg-launcher",
        "releaseType": "release"
      }
    ]
  }
}
